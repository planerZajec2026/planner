# Copy to .env.local and fill in. Never commit real values.
#
# Local development (spec 08): run `npm run db:start`, then copy the API URL and the publishable key
# (older CLI output calls it the anon key) from `npm run db:status`.
# Production / Preview (spec 09): set these in Vercel's project settings, from the Supabase dashboard
# (Settings → API Keys). Both are public by design; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
