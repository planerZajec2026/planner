# Copy to .env.local and fill in. Never commit real values.
#
# Local development (spec 08): run `npm run db:start`, then copy the API URL and the publishable key
# (older CLI output calls it the anon key) from `npm run db:status`.
# Production / Preview (spec 09): set these in Vercel's project settings, from the Supabase dashboard
# (Settings → API Keys). Both are public by design; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Spec 13 (generator planu): the Server Action that queues a generation job writes with the service_role key
# (`npm run db:status`, "service_role key"; in the cloud: Supabase dashboard → Settings → API Keys, secret key).
# Server-only: never prefix it with NEXT_PUBLIC_, never commit it. Until login exists (spec 11) this is the only
# way the app can write to the database.
SUPABASE_SERVICE_ROLE_KEY=
